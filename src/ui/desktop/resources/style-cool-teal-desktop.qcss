QWidget {
    font-family: "Noto Sans";
    background-color: #1e1f28;
    color: #aeb5c0;
    font-size: 13px;
}

QPushButton:hover {
    border: 1px solid #ff6b00;
}

QPushButton:pressed {
    background-color: #ff6b00;
    color: #0b0d12;
}

QTreeView::item:selected,
QListView::item:selected {
    background-color: #2a2c3a;
    color: #e6eaf2;
}

QTreeView::item:hover,
QListView::item:hover {
    background-color: #242632;
}

QLabel#FolderBrowserTitle {
    background: transparent;
    color: #e6eaf2;
    border-radius-top-left: 4px;
    border-radius-top-right: 4px;
    margin: 4px 4px 0;
    border-bottom: 1px solid #252732;
    padding: 8px 8px 8px;
}

QTreeView#FolderTreeView {
    background-color: #1e1f28;
    color: #aeb5c0;
    border-radius-bottom-left: 4px;
    border-radius-bottom-right: 4px;
    border:none;
    outline: none;
    padding: 0 3px 3px;
}

QTreeView#FolderTreeView::item {
    padding: 2px 6px;
    border: none;
}

QTreeView#FolderTreeView::item:hover {
    background-color: #292b37;
    color: #e6eaf2;
}

QTreeView#FolderTreeView::item:selected {
    color: #aeb5c0;
}

QTreeView#FolderTreeView::branch {
    width: 10px;
}

QWidget#FolderActionHoverColor {
    background-color: #292b37;
}

#container {
    border-radius: 8px;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background-color: #404452;
    min-height: 40px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background-color: #555b6e;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background: transparent;

    height: 10px;

    margin: 2px;
}

QScrollBar::handle:horizontal {
    background-color: #404452;
    min-width: 40px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #555b6e;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
}

/* Top bar and panels */

#NfTopBar, #NfPanel, #NfMainMenu {
    background-color: #242632;
    border: 1px solid #323546;
    border-radius: 2px;
}

#NfMainMenu {
    border: none;
}

#NfMainMenu QPushButton {
    background-color: transparent;
    color: #aeb5c0;
    border: none;
    border-left: 2px solid transparent;
    border-radius: 0;
    padding: 7px 10px;
    text-align: left;
    font-weight: 600;
}

#NfMainMenu QPushButton:hover {
    background-color: #2a2c3a;
    color: #e6eaf2;
    border: none;
    border-left: 2px solid transparent;
}

#NfMainMenu QPushButton:pressed {
    background-color: transparent;
    color: #ff6b00;
}

#NfMainMenu QPushButton:checked {
    background-color: transparent;
    color: #f3f4f6;
    font-weight: 700;
    border-left-color: #596273;
}

/* Top bar */

#NfTopBar {
    border-top: 3px solid #323546;
    border-left: 1px solid #323546;
    border-right: 1px solid #323546;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    margin-bottom: 4px;
    padding: 2px;
    padding-left: 5px;
}

#NfTopBar QLabel#TitleSeparator {
    color: #777b8e;
    padding: 0;
}

#NfTopBar QLabel#NfLogo,
#NfTopBar QLabel#TitleSeparator {
    background-color: transparent;
}

#NfTopBar QLabel#CurrentLibraryIcon,
#NfTopBar QLabel#CurrentLibraryName {
    background-color: transparent;
    color: #c5c7d3;
    font-size: 13px;
    padding: 0;
}

#NfTopBar QToolButton#SettingsButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 4px;
}

#NfTopBar QToolButton#SettingsButton:hover {
    background-color: #323546;
}

#NfTopBar QToolButton#SettingsButton:pressed {
    background-color: #383b4e;
}

#NfTopBar QPushButton#btnMinimize,
#NfTopBar QPushButton#btnMaximize,
#NfTopBar QPushButton#btnClose {
    background-color: #8f91a0;
    border-radius: 4px;
    color: #1e1f28;
}

#NfTopBar QPushButton#btnClose {
    background-color: #c0c0c0;
}

#NfTopBar QPushButton:hover {
    filter: brightness(1.2);
}

#NfTopBar QPushButton:pressed {
    filter: brightness(0.9);
}

/* Side panels */

#NfPanel {
    width: 250px;
    min-width: 250px;
    max-width: 250px;

    /* subtle checker pattern */
    background-image: linear-gradient(
        45deg,
        #2e3140 25%,
        transparent 25%,
        transparent 75%,
        #2e3140 75%,
        #2e3140
    ),
    linear-gradient(
        45deg,
        #2e3140 25%,
        transparent 25%,
        transparent 75%,
        #2e3140 75%,
        #2e3140
    );

    background-size: 4px 4px;
    background-position: 0 0, 2px 2px;
}

/* Left panel */

#NfPanel[side="left"] {
    border-left: 1px solid #323546;
    border-bottom: 1px solid #323546;
    border-bottom-left-radius: 8px;
}

/* Right panel */

#NfPanel[side="right"] {
    border-right: 1px solid #323546;
    border-bottom: 1px solid #323546;
    border-bottom-right-radius: 8px;
}

/* Central area */

#NfCentralWidget {
    background-color: #20222e;
    border-bottom: 1px solid #323546;
}

/* Settings Dialog */

QDialog {
    background-color: #1e1f28;
    color: #e6eaf2;
    border-radius: 8px;
}

QListWidget#SettingsCategories {
    background-color: #242632;
    border: 1px solid #323546;
    border-radius: 4px;
    padding: 4px;
}

QListWidget#SettingsCategories::item {
    padding: 7px 8px;
    border-radius: 3px;
}

QListWidget#SettingsCategories::item:selected {
    background-color: #323546;
    color: #e6eaf2;
    border-left: 2px solid #ff6b00;
}

QListWidget#SettingsCategories::item:hover:!selected {
    background-color: #2a2c3a;
}

QStackedWidget#SettingsPages {
    background-color: #242632;
    border: 1px solid #323546;
    border-radius: 4px;
}

QScrollArea#SettingsScrollArea,
QScrollArea#SettingsScrollArea QWidget {
    background-color: transparent;
}

QLabel#SettingsPageTitle {
    color: #e6eaf2;
    font-size: 15px;
    font-weight: bold;
    padding-bottom: 3px;
}

QLabel#SettingsDescription {
    color: #8f96a6;
    font-size: 11px;
}

QDialog QGroupBox {
    border: 1px solid #323546;
    border-radius: 4px;
    margin-top: 9px;
    padding: 8px;
    font-weight: bold;
}

QDialog QGroupBox::title {
    subcontrol-origin: margin;
    left: 8px;
    padding: 0 4px;
}

QTabWidget::pane {
    border: 1px solid #323546;
    background-color: #242632;
    border-radius: 6px;
}

QTabBar::tab {
    background: #2a2c3a;
    border: 1px solid #323546;
    padding: 6px 12px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background: #ff6b00;
    color: #0b0d12;
}

QPushButton {
    background-color: #242632;
    border: 1px solid #323546;
    border-radius: 4px;
    padding: 4px 12px;
}

QPushButton:hover {
    border: 1px solid #ff6b00;
}

QPushButton:pressed {
    background-color: #ff6b00;
    color: #0b0d12;
}

QLineEdit, QComboBox, QSlider, QSpinBox {
    background-color: #20222e;
    color: #e6eaf2;
    border: 1px solid #323546;
    border-radius: 4px;
}

QCheckBox {
    padding: 2px;
}

/* ================ NfBrowserViewModeBar =============== */

/* Outer bar container */
NfDesktop--NfBrowserViewModeBar {
/*    background-color: #121824;
    border: 1px solid #232d3f;*/
    border-radius: 6px;
    padding: 2px;
}

/* Base button style */
NfDesktop--NfBrowserViewModeBar QToolButton {
    background-color: transparent;
    color: #94a3b8;
    border: 1px solid transparent; /* Reserve 1px border space to prevent layout jump */
    border-radius: 4px;
    font-size: 14px;
    padding: 0;
    margin: 0;
}

/* Hover state */
NfDesktop--NfBrowserViewModeBar QToolButton:hover {
    background-color: #1e293b;
    color: #f8fafc;
}

/* Active / Checked state */
NfDesktop--NfBrowserViewModeBar QToolButton:checked {
    background-color: #292c38;
    color: #e6eaf2;
}

/* Active + Hover state */
NfDesktop--NfBrowserViewModeBar QToolButton:checked:hover {
    background-color: #323646;
}

NfDesktop--NfBrowserViewModeBar QToolButton:focus {
    outline: none;
}

/* ================ NfBreadcrumbView ==================== */

/* Container widget */
NfDesktop--NfBreadcrumbView {
    min-height: 36px;
    max-height: 36px;
    border-radius: 6px;
    padding: 0px;
}

/* Individual breadcrumb items & navigation arrow buttons */
NfDesktop--NfBreadcrumbView QToolButton {
    background-color: transparent;
    color: #94a3b8;
    border-radius: 4px;
    font-size: 12px;
    padding: 3px 8px;
    margin: 0;
}

/* Hover state */
NfDesktop--NfBreadcrumbView QToolButton:hover {
    background-color: #1e293b;
    color: #f8fafc;
 }

/* Pressed state */
NfDesktop--NfBreadcrumbView QToolButton:pressed {
    background-color: #0b0d12;
    color: #38bdf8;
}

/* Active path item (Checked state) */
NfDesktop--NfBreadcrumbView QToolButton:checked {
    background-color: #1a2332;
    color: #38bdf8;
    font-weight: bold;
}

/* Disabled navigation arrows (when at start/end of model) */
NfDesktop--NfBreadcrumbView QToolButton:disabled {
    background-color: transparent;
    color: #475569;
}

NfDesktop--NfBreadcrumbView QToolButton:focus {
    outline: none;
}

/* Container resets */
NfDesktop--NfBrowserSortBar,
NfDesktop--NfBrowserFilterBar {
    background: transparent;
    border: none;
}

/* Flat interactive QToolButtons */
NfDesktop--NfBrowserSortBar QToolButton,
NfDesktop--NfBrowserFilterBar QToolButton,
NfDesktop--NfBrowserTopBar QToolButton#editInButton {
    background: transparent;
    border: none;
    outline: none;
    color: #a0a5b5;
    padding: 2px 6px;
}

NfDesktop--NfBrowserTopBar NfDesktop--NfBrowserSortBar QToolButton:hover,
NfDesktop--NfBrowserTopBar NfDesktop--NfBrowserFilterBar QToolButton:hover,
NfDesktop--NfBrowserTopBar QToolButton#editInButton:hover {
    color: #ffffff;
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 4px;
}

NfDesktop--NfBrowserTopBar NfDesktop--NfBrowserSortBar QToolButton:pressed,
NfDesktop--NfBrowserTopBar NfDesktop--NfBrowserFilterBar QToolButton:pressed,
NfDesktop--NfBrowserTopBar QToolButton#editInButton:pressed {
    color: #ffffff;
    background-color: rgba(255, 255, 255, 0.10);
    border-radius: 4px;
}

/* ================ NfThumbnailsView ==================== */

NfDesktop--NfThumbnailsView {
    background-color: #20222e;
    border: none;
    outline: none;
    padding: 8px;
}

NfDesktop--NfThumbnailsView::item {
    background-color: #242632;
    color: #aeb5c0;
    border-radius: 2px;
    border-top: 1px solid #2e303f;
    border-left: 1px solid #2e303f;
    border-right: 2px solid #181922;
    border-bottom: 2px solid #181922;
}

NfDesktop--NfThumbnailsView::item:hover {
    background-color: #292b37;
    color: #e6eaf2;
    border-top: 1px solid #35384a;
    border-left: 1px solid #35384a;
    border-right: 2px solid #13141c;
    border-bottom: 2px solid #13141c;
}

NfDesktop--NfThumbnailsView::item:selected {
    background-color: #303440;
    border: 1px solid #596273;
}

NfDesktop--NfThumbnailsView::item:selected:hover {
    background-color: #353947;
    border: 1px solid #687284;
}

NfDesktop--NfThumbnailsView::item:selected:!active {
    background-color: #2c2f3a;
    border: 1px solid #484e5b;
}

NfDesktop--NfLibraryListView,
NfDesktop--NfRepresentationListView,
NfDesktop--NfLibraryTreeView {
    background-color: transparent;
    border: none;
    outline: none;
}

NfDesktop--NfLibraryListView,
NfDesktop--NfRepresentationListView {
    border-bottom: 3px solid #242632;
}

NfDesktop--NfLibraryListView::item,
NfDesktop--NfRepresentationListView::item,
NfDesktop--NfLibraryTreeView::item {
    margin: 2px 6px;
    border-radius: 3px;
}

NfDesktop--NfLibraryListView::item:hover,
NfDesktop--NfRepresentationListView::item:hover,
NfDesktop--NfLibraryTreeView::item:hover {
    background-color: #292b37;
    color: #e6eaf2;
}

NfDesktop--NfLibraryListView::item:selected,
NfDesktop--NfRepresentationListView::item:selected,
NfDesktop--NfLibraryTreeView::item:selected {
    background-color: #323546;
    color: #f3f4f6;
}

NfDesktop--NfLibraryListView::item:selected:!active,
NfDesktop--NfRepresentationListView::item:selected:!active,
NfDesktop--NfLibraryTreeView::item:selected:!active {
    background-color: #2a2c3a;
    color: #e6eaf2;
}

/* ================ NfLibraryListHeader ================= */

NfDesktop--NfLibraryListHeader {
    min-height: 32px;
    max-height: 32px;
    background-color: #292b38;
    border-bottom: 1px solid #323546;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 0px;
}

NfDesktop--NfLibraryListHeader QLabel {
    background: transparent;
    color: #c5cad4;
    font-size: 11px;
    font-weight: 600;

    padding: 0px;
}

NfDesktop--NfLibraryListHeader QPushButton {
    min-width: 20px;
    max-width: 20px;
    min-height: 20px;
    max-height: 20px;
    background-color: transparent;
    color: #7f8798;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 0px;
}

NfDesktop--NfLibraryListHeader QPushButton:hover {
    background-color: #2e3140;
    color: #e6eaf2;
    border: 1px solid #3a3e50;
}

NfDesktop--NfLibraryListHeader QPushButton:pressed {
    background-color: #1a2332;
    color: #ff6b00;
    border: 1px solid #ff6b00;
}

NfDesktop--NfLibraryListHeader QPushButton:focus {
    outline: none;
}

NfDesktop--NfCollapsibleSection QToolButton {
    border: none;
    background: transparent;
    padding: 6px 8px;
    font-weight: 600;
    color: #aeb5c0;
    text-align: left;
    border-radius: 4px;
}

NfDesktop--NfCollapsibleSection QToolButton:hover {
    background: #242632;
    color: #e6eaf2;
}

NfDesktop--NfCollapsibleSection QToolButton:pressed {
    background: #323546;
    color: #ff6b00;
}

NfDesktop--NfCollapsibleSection QToolButton:checked {
    background: transparent;
    color: #e6eaf2;
}

NfDesktop--NfCollapsibleSection QToolButton:checked:hover {
    background: #242632;
    color: #e6eaf2;
}

NfDesktop--NfCollapsibleSection QToolButton:focus {
    outline: none;
}

NfDesktop--NfMetadataSectionWidget QLabel#metadataKeyColorProbe {
    color: #8c93a2;
}

NfDesktop--NfMetadataSectionWidget QLabel#metadataValueColorProbe {
    color: #ebf0f5;
}

NfDesktop--NfMetadataSectionWidget QTableView::item {
    padding-top: 2px;
    padding-bottom: 2px;
    border: none;
    background: transparent;
}

NfDesktop--NfMetadataSectionWidget QTableView {
    background: transparent;
    border: none;
    gridline-color: transparent;
}
